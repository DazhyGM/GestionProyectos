<Window x:Class="GestionProyectos.Views.Graficas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
        mc:Ignorable="d"
        Title="Dashboard de Gráficas por Usuario"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#2196F3" BorderBrush="#1976D2" BorderThickness="0,0,0,3" Margin="0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="40" Height="40" Fill="White" Margin="0,0,15,0"/>
                    <TextBlock Text="Gestión de Proyectos"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Volver"
                            Background="#9C27B0"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="20,10"
                            Margin="0,0,15,0"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnVolver_Click"/>

                    <Border Background="White" CornerRadius="20" Padding="15,8" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="30" Height="30" Fill="#FF9800" Margin="0,0,10,0"/>
                            <TextBlock x:Name="txtUsuarioNombre"
                                       Text="Usuario"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#333"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Cerrar Sesión"
                            Background="#F44336"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Padding="20,10"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnCerrarSesion_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Height="514" VerticalAlignment="Center">
            <StackPanel Margin="20">

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Dashboard de Gráficas por Usuario"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#9C27B0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Grid.Column="0"/>

                    <Button x:Name="BtnExportar"
                            Content="Exportar Reporte"
                            Width="140" Height="30"
                            Background="#FB8B24"
                            Foreground="White"
                            Click="BtnExportar_Click"
                            Grid.Column="1"
                            Margin="10,0,0,0"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <TextBlock Text="Filtrar tareas:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="cmbUsuarios"
                              Width="200" Height="30"
                              SelectionChanged="cmbUsuarios_SelectionChanged"/>
                </StackPanel>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#F8F9FA"
                            CornerRadius="8"
                            Margin="5"
                            BorderThickness="1"
                            BorderBrush="#E0E0E0">
                        <StackPanel>
                                       <TextBlock
                                       FontWeight="Bold"
                                       Foreground="#333"
                                       HorizontalAlignment="Center"
                                       Margin="10,10,10,5"/>
                            <oxy:PlotView x:Name="chartBarras"
                                          Height="200"
                                          Background="White"
                                          Margin="5"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="#F8F9FA"
                            CornerRadius="8"
                            Margin="5"
                            BorderThickness="1"
                            BorderBrush="#E0E0E0">
                        <StackPanel>
                                       <TextBlock
                                       FontWeight="Bold"
                                       Foreground="#333"
                                       HorizontalAlignment="Center"
                                       Margin="10,10,10,5"/>
                            <oxy:PlotView x:Name="chartPastel"
                                          Height="200"
                                          Background="White"
                                          Margin="5"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#F8F9FA"
                        CornerRadius="8"
                        Margin="5"
                        BorderThickness="1"
                        BorderBrush="#E0E0E0">
                    <StackPanel>
                        <TextBlock x:Name="txtInfoProyectos"
                                   Margin="10,5,10,10"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <oxy:PlotView x:Name="chartLineas"
                                      Height="250"
                                      Background="White"
                                      Margin="5"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
